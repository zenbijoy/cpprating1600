# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"
PORT=3000

# SUPABASE CONFIGURATION: Full-Stack Authentication & PostgreSQL Database
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PROJECT_ID="your-project-id"
SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# VITE CLIENT-SIDE CONFIGURATION (exposed to React frontend)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# GOOGLE OAUTH CONFIGURATION (for Google Sign-In on Web and Native Android)
# Web Client ID (ending in .apps.googleusercontent.com)
VITE_GOOGLE_CLIENT_ID="your-google-web-client-id.apps.googleusercontent.com"
# Android OAuth Client ID (registered with package com.climb1600.companion and SHA-1 fingerprint)
ANDROID_GOOGLE_CLIENT_ID="your-google-android-client-id.apps.googleusercontent.com"

# CODE EXECUTION CONFIGURATION (Playground Runner)
# Optional: External Judge0 / Piston execution URL.
# If omitted or unreachable, defaults to the secure local sandboxed runner (GCC/G++ and Python 3)
# CODE_EXECUTION_URL="http://localhost:2358"
# CODE_EXECUTION_API_KEY=""

# NOTIFICATION & REMINDER SYSTEM CONFIGURATION
# Web Push (W3C Push API / VAPID): Auto-generated if not provided
# VAPID_PUBLIC_KEY="BK..."
# VAPID_PRIVATE_KEY="4k..."
# VAPID_SUBJECT="mailto:admin@climb1600.com"

# CLOUDFLARE R2 FILE & MEDIA STORAGE CONFIGURATION (S3-Compatible Object Store)
# Used for images, video posts, PDFs, solution files, avatars, and cover images.
# If omitted, system automatically falls back to secure local file storage in public/uploads/
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="climb1600-media"
R2_PUBLIC_URL="https://media.climb1600.com"

# Android Push (Firebase Cloud Messaging):
# FCM_SERVER_KEY="your-firebase-server-key"

# Optional Email Channel (Resend / SMTP):
# RESEND_API_KEY="re_..."
# NOTIFICATION_EMAIL_FROM="CLIMB 1600 <notifications@climb1600.com>"

# Background Worker & Polling Intervals (milliseconds)
# CF_POLLING_INTERVAL_MS=120000          # 2 minutes default for CF submission & contest sync
# NOTIFICATION_POLL_INTERVAL_MS=15000     # 15 seconds default for durable scheduled queue

